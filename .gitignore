# Dependencies
node_modules/
# This repo uses npm (package-lock.json). Stray pnpm-lock.yaml files
# can appear if someone accidentally runs `pnpm install` — never commit them.
pnpm-lock.yaml

# Environment files (secrets - never commit these!)
# Covers dev/stg/prod and any org slug (e.g. .env.acme-production)
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

tmp/

# Engine state lives in state/<org>/ and is committed (see state/README.md),
# except what each machine keeps for itself under state/<org>/local/:
#   baselines/  "the last platform state I saw" per resource, for drift
#               detection. Committing it would make one developer's baseline
#               everyone's.
#   snapshots/  copies written by `npm run push` for `npm run rollback`.
state/*/local/

# The same two stores where they sat before state/ existed. The engine moves
# them on the next pull, push or apply; until then they stay out of git.
.vapi-state.*.snapshots/
.vapi-state-hash/

# Dashboard-backup copies written by the push conflict prompt for manual
# merging (<name>.<TIMESTAMP>.bkp.md|yml). Scratch material, never committed.
*.bkp.*

# Local agent state
.claude/
.agent/
.agent/handoffs/
.claude/handoffs/

# Local scratch notes
requested improvements.md
